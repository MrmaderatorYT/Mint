<?xml version="1.0" encoding="utf-8"?>
<!--
  One pane at a time. The bottom bar switches between them, so each pane owns the
  full width: a disassembly line needs it, and on a phone there is no width to
  spare for a second column.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="middle"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_another"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_binary_short" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/project_actions"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/project_actions"
            app:icon="@android:drawable/ic_menu_more" />

        <!-- The bundled disassembler is BSD-licensed, and that licence requires its
             notice to reach whoever receives the binary. A screen inside the app is
             the only place a user actually can receive it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/about"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/licences"
            app:icon="@android:drawable/ic_menu_info_details" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_analysis"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/cancel_analysis" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:indeterminate="true" />

    <!-- Shown until a binary is opened. There is nothing useful to display before
         that, and inventing something would only look like a working tool. -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/open_binary" />

        <!-- Something to open when the user has nothing to hand. Without it the
             first screen is a dead end unless they already know which file on the
             device is worth analysing. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/try_example"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/try_example" />
    </LinearLayout>

    <!--
      Shown only while a function is selected. Outside the content frame on purpose:
      the graph fills that frame, so a chip placed inside it would be hidden behind
      the canvas in exactly the pane where "which function am I in" is least obvious.
    -->
    <!--
      One chip per open function, not one for the selection. A reverse-engineering
      session is several functions at once — a caller, its callee, the helper both
      use — and holding only the latest means every comparison is a round trip
      through the function list. The row scrolls because names are long and a phone
      is narrow.
    -->
    <HorizontalScrollView
        android:id="@+id/open_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/open_functions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="4dp"
                android:hint="@string/filter_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical" />

            <!-- Vertical outside, horizontal inside: IR and pseudo-C lines are long
                 and must not wrap, because a wrapped line stops looking like code. -->
            <ScrollView
                android:id="@+id/text_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:textIsSelectable="true"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.15" />
                </HorizontalScrollView>
            </ScrollView>
        </LinearLayout>

        <com.ccs.mint.ui.components.GraphView
            android:id="@+id/graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!--
      A scrolling tab strip rather than a BottomNavigationView. That component caps
      out at five destinations and distributes them across the width, so the sixth
      pane does not fit and the five that do are squeezed until their labels elide.
      Scrollable tabs keep every label readable and leave room for panes added later.
    -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:tabGravity="start"
        app:tabIndicatorGravity="top"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp" />
</LinearLayout>
