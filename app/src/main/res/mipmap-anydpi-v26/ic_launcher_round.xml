<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. minSdk is 26, so every device this app runs on resolves this
     file and the raster mipmaps are only a fallback for surfaces that do not read
     adaptive icons at all. The monochrome layer is what Android 13+ tints for
     themed icons. Its even-odd graph cutout stays transparent when tinted. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
