<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3, not AppCompat. The workspace uses M3 components — the bottom
         navigation bar, the text appearance attributes — and under an AppCompat
         parent those attributes do not resolve, which fails at inflation time
         rather than at build time. -->
    <style name="Base.Theme.Mint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mint_primary</item>
        <item name="colorOnPrimary">@color/mint_on_primary</item>
        <item name="colorPrimaryContainer">@color/mint_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mint_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/mint_primary_inverse</item>
        <item name="colorSecondary">@color/mint_secondary</item>
        <item name="colorOnSecondary">@color/mint_on_secondary</item>
        <item name="colorSecondaryContainer">@color/mint_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/mint_on_secondary_container</item>
        <item name="colorTertiary">@color/mint_tertiary</item>
        <item name="colorOnTertiary">@color/mint_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/mint_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/mint_on_tertiary_container</item>
        <item name="colorSurface">@color/mint_surface</item>
        <item name="colorOnSurface">@color/mint_on_surface</item>
        <item name="colorSurfaceVariant">@color/mint_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/mint_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/mint_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/mint_surface_low</item>
        <item name="colorSurfaceContainer">@color/mint_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/mint_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/mint_surface_highest</item>
        <item name="colorOutline">@color/mint_outline</item>
        <item name="colorOutlineVariant">@color/mint_outline_variant</item>
        <item name="colorPrimaryFixed">#9FF2C1</item>
        <item name="colorPrimaryFixedDim">#83D6A6</item>
        <item name="colorOnPrimaryFixed">#00210F</item>
        <item name="colorOnPrimaryFixedVariant">#005233</item>
        <item name="colorSecondaryFixed">#CDE9D5</item>
        <item name="colorSecondaryFixedDim">#B2CCBB</item>
        <item name="colorOnSecondaryFixed">#082016</item>
        <item name="colorOnSecondaryFixedVariant">#344C3E</item>
        <item name="colorTertiaryFixed">#BFE9F7</item>
        <item name="colorTertiaryFixedDim">#A4CDDA</item>
        <item name="colorOnTertiaryFixed">#001F28</item>
        <item name="colorOnTertiaryFixedVariant">#244C58</item>
        <item name="colorSurfaceBright">@color/mint_surface_bright</item>
        <item name="colorSurfaceDim">@color/mint_surface_dim</item>
        <item name="colorSurfaceInverse">@color/mint_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/mint_on_surface_inverse</item>
        <item name="colorBackgroundFloating">@color/mint_surface_high</item>
        <item name="android:colorAccent">@color/mint_primary</item>
        <item name="android:colorBackground">@color/mint_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>